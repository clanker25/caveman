{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": false,
    "noUncheckedIndexedAccess": true,
    "noEmit": false,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
